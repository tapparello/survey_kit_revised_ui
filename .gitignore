# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# Absolute symlink back to this repo root, created by `pod install`. Already
# covered by example/ios/.gitignore; listed here because an unrestricted
# build_runner run traverses it and writes into this working tree. See ADO #1001
# and build.yaml.
example/ios/.symlinks/
/build/

# Web related
lib/generated_plugin_registrant.dart

# Test coverage output
coverage/

# Local tooling scratch space
.superpowers/

# Private planning docs - specs and implementation plans stay local only.
# They contain absolute paths, internal project names, and other details that
# must not be published to this public repository.
docs/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
